# dependencies
node_modules/

# next.js
.next/
out/

# env — never commit secrets
.env
.env.local
.env*.local
# ...and anything derived from them: .env*.local does NOT match a .bak,
# which is how a copy of a secrets file nearly got committed (10 Sep 2026)
.env*
*.bak
# the one env file that MUST be committed — it documents the keys, holds none
!.env.local.example

# builds & caches
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts (not project code)
ruvector.db
supabase/.temp/

# playwright artifacts
test-results/
playwright-report/

# misc
.DS_Store

# local Claude Code session config
.claude/

# screenshot rigs write here (scripts/shots/*.js)
scripts/shots/shots/
