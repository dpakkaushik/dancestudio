# dependencies
node_modules/

# next.js
.next/
out/

# env — never commit secrets
.env
.env.local
.env*.local
# ...and anything derived from them: .env*.local does NOT match a .bak,
# which is how a copy of a secrets file nearly got committed (10 Sep 2026)
.env*
*.bak
# the one env file that MUST be committed — it documents the keys, holds none
!.env.local.example

# builds & caches
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts (not project code)
ruvector.db
supabase/.temp/

# playwright artifacts
test-results/
playwright-report/

# misc
.DS_Store

# local Claude Code session config
.claude/

# screenshot rigs write here (scripts/shots/*.js)
scripts/shots/shots/

# ⚠ RELEASE BINARIES ARE NOT SOURCE (29 Sep 2026). `danceos-1.1.0.apk` and
# `.aab` were tracked, ~4 MB each, and a repo that carries one per release grows
# for ever. They are untracked from here; the two that exist STAY IN HISTORY, so
# nothing is lost and no rewrite was needed — which also means no force-push and
# nobody's clone breaks. Build output belongs with a release, not in the tree.
android/*.apk
android/*.aab

# ⚠ AND THE SIGNING KEY IS NOT SOURCE EITHER, and never has been: it has never
# been committed (checked with `git log --diff-filter=A` across all history) and
# it does not exist on this machine at all — it lives only on the PC this repo
# was copied from. Losing it means a new package identity for the app, so it
# belongs in a password manager or a secret store, not here.
*.keystore
*.jks

# the live-catalog snapshot a dry run diffs against (scripts/dry-run-checks/*.snapshot.js writes it)
scripts/dry-run-checks/before.json
