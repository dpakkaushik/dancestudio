# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never get committed.

# Supabase (from your project's Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres password — needed by the Supabase CLI for migrations (supabase db push)
SUPABASE_DB_PASSWORD=your-db-password

# Resend (resend.com → API Keys) — the app never reads this at runtime; it is the
# SMTP password configured on the Supabase project (Auth → SMTP, user "resend",
# host smtp.resend.com:465) so magic-link emails aren't capped at ~2/hour.
RESEND_API_KEY=re_your-key

# Razorpay (dashboard.razorpay.com → Settings → API Keys). Until KEY_ID/SECRET are
# set, paid classes show "payments aren't switched on yet" and free classes work.
# WEBHOOK_SECRET is the secret you type when creating the webhook (Settings →
# Webhooks → your deployment URL + /api/webhooks/razorpay, events: payment.captured,
# payment.failed, refund.processed, refund.failed).
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
