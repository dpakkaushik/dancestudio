# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never get committed.

# Supabase (from your project's Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres password — needed by the Supabase CLI for migrations (supabase db push)
SUPABASE_DB_PASSWORD=your-db-password

# Resend (resend.com → API Keys) — the app never reads this at runtime; it is the
# SMTP password configured on the Supabase project (Auth → SMTP, user "resend",
# host smtp.resend.com:465) so magic-link emails aren't capped at ~2/hour.
RESEND_API_KEY=re_your-key

# Cashfree Payment Gateway (merchant.cashfree.com → Developers → Payment Gateway
# → API Keys). Test keys are auto-generated at sign-up; live keys need KYC.
# CASHFREE_ENV=sandbox points at sandbox.cashfree.com, production at api.cashfree.com.
# Until APP_ID/SECRET_KEY are set, paid classes show "payments aren't switched on
# yet" and free classes work. Webhooks are signed with the SECRET KEY (no separate
# webhook secret): register {deployment}/api/webhooks/cashfree for the payment
# and refund events (PAYMENT_SUCCESS / FAILED / USER_DROPPED, REFUND_STATUS) AND,
# since 10 Sep 2026, the Subscriptions family — SUBSCRIPTION_PAYMENT_SUCCESS /
# FAILED / CANCELLED, SUBSCRIPTION_AUTH_STATUS, SUBSCRIPTION_STATUS_CHANGED — for
# the per-studio and Artist plans (Rs 1,200 / Rs 700 a month, set on /admin/plans).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=TEST_your-app-id
CASHFREE_SECRET_KEY=cfsk_ma_test_your-secret

# Cashfree Payouts (Developers → Payouts → API Keys) — a SEPARATE key pair. Not
# wired into the app yet: studios are settled through Easy Split (Cashfree pays
# the studio's share to the studio's own bank) and a studio pays its people from
# its own account. Kept here so the sandbox smoke proof can report the pair, and
# note Payouts also needs the caller's IPv4 whitelisted (or the 2FA public-key
# signature) before it answers anything but 403.
CASHFREE_PAYOUT_CLIENT_ID=CF_your-payout-client-id
CASHFREE_PAYOUT_CLIENT_SECRET=cfsk_ma_test_your-payout-secret

# ── Phone OTP channel (Step 26) ───────────────────────────────────────────────
# Step 1 decided WhatsApp-first with an SMS fallback and parked it; the code has
# always been one argument, and this is the switch. Unset behaves as SMS.
#
#   AUTH_OTP_CHANNEL=whatsapp   → Supabase sends the code on WhatsApp
#   AUTH_OTP_CHANNEL=sms        → by SMS (the default, and what is configured now)
#   AUTH_OTP_FALLBACK_SMS=true  → a refused WhatsApp send goes by SMS instead,
#                                 and the screen then says SMS, not WhatsApp
#   AUTH_OTP_LIVE_NUMBERS=true  → the sign-in screen stops saying "a real number
#                                 cannot be reached yet"; set it only once the
#                                 provider below can actually deliver
#
# What the project has today (read from the live auth config, 28 Aug 2026): phone
# sign-in ENABLED, provider "twilio", and NO Twilio credentials — so only
# Supabase's test numbers (99999 99999 / 88888 88888, OTP 123456) can receive
# anything, whichever channel is chosen. What the user must do to make either
# channel real:
#   * Twilio account → Messaging Service (SMS) and/or a WhatsApp sender, then put
#     the Account SID / Auth Token / Message Service SID into Supabase
#     (Authentication → Providers → Phone);
#   * WhatsApp: Meta business verification + an APPROVED authentication template
#     (Twilio Verify or the WhatsApp Business API), or the send is refused;
#   * SMS to Indian numbers: DLT registration (entity + header + template), or
#     the carriers drop it.
# AUTH_OTP_CHANNEL=sms
# AUTH_OTP_FALLBACK_SMS=true
# AUTH_OTP_LIVE_NUMBERS=true

# Google Maps Platform (11 Sep 2026). The app uses Google for the map, for
# address/city search (Places Autocomplete) and for turning a dragged pin into
# an address (Geocoding) — there is no hardcoded city list any more.
#
# TWO NAMES, AND THEY ARE NOT THE SAME KEY IN PRODUCTION:
#   NEXT_PUBLIC_GOOGLE_MAPS_KEY — drawn in the BROWSER, so it is visible in the
#     page source. That is unavoidable for a map; restrict it by HTTP referrer
#     to your own domains and it is safe.
#   GOOGLE_MAPS_KEY — used only on the SERVER, for Places and Geocoding. It
#     spends quota, so it never reaches a browser; restrict it to those APIs.
#
# A Maps DEMO KEY (developers.google.com/maps/documentation/javascript/demo-key)
# works for both while prototyping: no billing, but a daily quota that PAUSES
# rather than charges, and Google states it is not for production. Every screen
# degrades to "the map is not available" rather than breaking when it runs out.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_KEY=
