# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never get committed.

# Supabase (from your project's Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres password — needed by the Supabase CLI for migrations (supabase db push)
SUPABASE_DB_PASSWORD=your-db-password

# Resend (resend.com → API Keys) — the app never reads this at runtime; it is the
# SMTP password configured on the Supabase project (Auth → SMTP, user "resend",
# host smtp.resend.com:465) so magic-link emails aren't capped at ~2/hour.
RESEND_API_KEY=re_your-key

# Cashfree Payment Gateway (merchant.cashfree.com → Developers → Payment Gateway
# → API Keys). Test keys are auto-generated at sign-up; live keys need KYC.
# CASHFREE_ENV=sandbox points at sandbox.cashfree.com, production at api.cashfree.com.
# Until APP_ID/SECRET_KEY are set, paid classes show "payments aren't switched on
# yet" and free classes work. Webhooks are signed with the SECRET KEY (no separate
# webhook secret): register {deployment}/api/webhooks/cashfree for the payment
# and refund events (PAYMENT_SUCCESS / FAILED / USER_DROPPED, REFUND_STATUS).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=TEST_your-app-id
CASHFREE_SECRET_KEY=cfsk_ma_test_your-secret

# Cashfree Payouts (Developers → Payouts → API Keys) — a SEPARATE key pair. Not
# wired into the app yet: studios are settled through Easy Split (Cashfree pays
# the studio's share to the studio's own bank) and a studio pays its people from
# its own account. Kept here so the sandbox smoke proof can report the pair, and
# note Payouts also needs the caller's IPv4 whitelisted (or the 2FA public-key
# signature) before it answers anything but 403.
CASHFREE_PAYOUT_CLIENT_ID=CF_your-payout-client-id
CASHFREE_PAYOUT_CLIENT_SECRET=cfsk_ma_test_your-payout-secret
